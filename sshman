def cmd_edit(args):
    hosts, preamble = parse_config()
    real = [h for h in hosts if h['Host'] != '*']
    alias = resolve_alias(real, args.alias, "Editar> ")
    host = require_host(real, alias)

    info(f"\n── Editando: {alias} ──────────────────────────────")
    info("  (Enter para mantener el valor actual)\n")

    host['hostname'] = prompt("Hostname / IP", default=host.get('hostname')) or host['hostname']
    host['user']     = prompt("Usuario", default=host.get('user')) or host['user']

    new_port = prompt("Puerto", default=host.get('port', '22'))
    if new_port and new_port != '22':
        if not valid_port(new_port):
            err(f"Puerto inválido: {new_port}"); sys.exit(1)
        host['port'] = new_port
    else:
        host.pop('port', None)

    new_key = prompt("Nueva llave .pem ('quitar' / Enter para mantener)")
    if new_key and new_key.lower() != 'quitar':
        host['identityfile'] = install_key(new_key, alias)
        host['identitiesonly'] = 'yes'
    elif new_key and new_key.lower() == 'quitar':
        host.pop('identityfile', None)
        host.pop('identitiesonly', None)

    # Jump
    current = host.get('proxyjump') or host.get('proxycommand')
    if current:
        info(f"\n  Jump actual: {current}")
        new_jump = prompt("Nuevo jump (usuario@host:puerto / 'quitar' / Enter)")
    else:
        new_jump = prompt("Agregar jump (usuario@host:puerto / Enter para omitir)")
    if new_jump:
        j = new_jump.strip()
        if j.lower() == 'quitar':
            host.pop('proxyjump', None)
            host.pop('proxycommand', None)
        else:
            jk_path = prompt("  Ruta llave jump .pem  (vacío si misma llave)")
            key_name, val = build_jump(j, jk_path)
            if not key_name:
                warn("Formato de jump inválido, se mantiene el actual.")
            else:
                host.pop('proxyjump', None)
                host.pop('proxycommand', None)
                host[key_name] = val

    # Env metadata
    meta = load_meta()
    cur_env = meta['hosts'].get(alias, {}).get('env', '')
    new_env = prompt("Entorno (prod/test/dev/bastion/otro / Enter para mantener)",
                     default=cur_env or None)
    if new_env:
        meta['hosts'].setdefault(alias, {})['env'] = new_env
        save_meta(meta)

    write_config(hosts, preamble)
    ok(f"'{alias}' actualizado.")

