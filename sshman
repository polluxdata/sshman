def cmd_rename(args):
    hosts, preamble = parse_config()
    real = [h for h in hosts if h['Host'] != '*']
    old_alias = resolve_alias(real, args.alias, "Renombrar> ")
    host = require_host(hosts, old_alias)

    new_alias = args.new_alias or prompt(f"Nuevo alias para '{old_alias}'", required=True)
    new_alias = (new_alias or '').strip()
    if not new_alias:
        err("El nuevo alias no puede estar vacío."); sys.exit(1)
    if ' ' in new_alias:
        err("El alias no puede contener espacios."); sys.exit(1)
    if get_host(hosts, new_alias):
        err(f"El alias '{new_alias}' ya existe."); sys.exit(1)

    host['Host'] = new_alias

    # Rename key file if it belongs to the vault and matches old alias
    kp = host.get('identityfile', '')
    if kp and str(KEYS_DIR) in kp and Path(kp).exists():
        old_key = Path(kp)
        new_key = KEYS_DIR / f"{new_alias}{old_key.suffix}"
        if not new_key.exists():
            old_key.rename(new_key)
            host['identityfile'] = str(new_key)
            ok(f"Llave renombrada a {new_key.name}")

    meta = load_meta()
    if old_alias in meta['hosts']:
        meta['hosts'][new_alias] = meta['hosts'].pop(old_alias)
        save_meta(meta)

    write_config(hosts, preamble)
    ok(f"'{old_alias}' renombrado a '{new_alias}'.")

# ----------------------------------------------------------------
# migrate  (import existing ~/.ssh/config hosts into the vault)
# ----------------------------------------------------------------
def cmd_migrate(args):
    ensure_vault()
    if not SSH_CONFIG.exists():
        warn("No existe ~/.ssh/config; nada que migrar.")
        return

    # Parse ~/.ssh/config directly (not the vault)
    src_hosts, current = [], None
    with open(SSH_CONFIG) as f:
        for line in f:
            s = line.strip()
            if not s or s.startswith('#'):
                continue
            if s.lower().startswith('include'):
                continue
            m = re.match(r'^Host\s+(.+)$', s, re.IGNORECASE)
            if m:
                if current:
                    src_hosts.append(current)
                current = {'Host': m.group(1).strip(), '_extra': []}
            elif current is not None:
                m2 = re.match(r'^(\S+)\s+(.+)$', s)
                if m2:
                    key, val = m2.group(1).lower(), _unquote(m2.group(2).strip())
                    if key in KNOWN_SSH_OPTIONS:
                        current[key] = val
                    else:
                        current['_extra'].append(line)
        if current:
            src_hosts.append(current)

    src_hosts = [h for h in src_hosts if h['Host'] != '*']
    if not src_hosts:
        warn("No se encontraron hosts para migrar en ~/.ssh/config.")
        return

    vault_hosts, preamble = parse_config()
    migrated, keys_copied = 0, 0
    for h in src_hosts:
        if get_host(vault_hosts, h['Host']):
            warn(f"'{h['Host']}' ya existe en el vault, se omite.")
            continue
        # Relocate IdentityFile into the vault (per-host name)
        kp = h.get('identityfile')
        if kp:
            dst = _copy_key_to_vault(kp, h['Host'])
            if dst:
                h['identityfile'] = str(dst)
                keys_copied += 1
            else:
                warn(f"Llave no encontrada para '{h['Host']}': {kp}")
        # Relocate ProxyCommand inline keys into the vault (original name)
        if 'proxycommand' in h:
            new_pc, n = _rewrite_proxycommand_keys(h['proxycommand'])
            if n > 0:
                h['proxycommand'] = new_pc
                keys_copied += n
        vault_hosts.append(h)
        migrated += 1

    write_config(vault_hosts, preamble)
    ok(f"Migrados {migrated} host(s) al vault "
       f"({keys_copied} llave(s) copiada(s) a ~/.sshman/keys/).")
    info("Revisa ~/.ssh/config y elimina manualmente los hosts duplicados "
         "que ahora gestiona sshman (vía Include).")


def _copy_key_to_vault(kp, alias):
    """Copy a key into the vault as <alias><suffix> (chmod 600).
    Returns the destination Path, or None if source missing."""
    KEYS_DIR.mkdir(parents=True, exist_ok=True)
    src = Path(os.path.expanduser(_unquote(str(kp))))
    if not src.exists() or not src.is_file():
        return None
    suffix = src.suffix if src.suffix in ('.pem', '.key') else '.pem'
    dst = KEYS_DIR / f"{alias}{suffix}"
    if not dst.exists():
        shutil.copy2(src, dst)
    os.chmod(dst, 0o600)
    return dst


def _rewrite_proxycommand_keys(proxycommand_str):
    """Find all -i <path> entries in a ProxyCommand, copy each key
    to the vault using its original filename, and rewrite the paths.
    Returns (new_proxycommand_str, num_keys_copied)."""
    KEYS_DIR.mkdir(parents=True, exist_ok=True)
    n = 0
    def _repl(m):
        nonlocal n
        orig = m.group(1).strip().strip('"').strip("'")
        src = Path(os.path.expanduser(orig))
        if not src.exists() or not src.is_file():
            return m.group(0)
        dst = KEYS_DIR / src.name
        if not dst.exists():
            shutil.copy2(src, dst)
            os.chmod(dst, 0o600)
        n += 1
        return f"-i {dst}"
    new_pc = re.sub(r'-i\s+("[^"]+"|\'[^\']+\'|\S+)', _repl, proxycommand_str)
    return new_pc, n

# ----------------------------------------------------------------
# export / import  (portable, encrypted with openssl by default)
# ----------------------------------------------------------------
def _openssl_available():
    return shutil.which('openssl') is not None

def _ask_passphrase(confirm=False):
    """Prompt for a passphrase via getpass (no echo). Optionally confirm."""
    while True:
        pw = getpass.getpass("Passphrase: ")
        if not pw:
            err("La passphrase no puede estar vacía."); sys.exit(1)
        if confirm:
            pw2 = getpass.getpass("Confirmar passphrase: ")
            if pw != pw2:
                err("Las passphrases no coinciden. Intenta de nuevo.")
                continue
        return pw

def cmd_export(args):
    ensure_vault()
    ts = datetime.now().strftime("%Y%m%d")
    default_name = f"sshman-vault-{ts}.tar.gz"
    if not args.no_encrypt:
        default_name += ".enc"
    out = Path(args.output) if args.output else Path.cwd() / default_name

    # Build tar.gz in a temp file
    import tempfile
    tmp = Path(tempfile.mktemp(suffix=".tar.gz"))
    with tarfile.open(tmp, "w:gz") as tar:
        for item in ("config", "keys", "meta.json"):
            p = VAULT_DIR / item
            if p.exists():
                tar.add(p, arcname=item)

    if args.no_encrypt:
        warn("═════════════════════════════════════════════════════════")
        warn(" Exportando SIN CIFRAR. El archivo contiene tus LLAVES")
        warn(" PRIVADAS en texto plano. No lo subas a la nube ni lo")
        warn(" envíes por canales inseguros.")
        warn("═════════════════════════════════════════════════════════")
        if not confirm("¿Continuar sin cifrar?"):
            tmp.unlink(missing_ok=True)
            warn("Cancelado."); return
        shutil.move(str(tmp), str(out))
        ok(f"Vault exportado (SIN CIFRAR): {out}")
        return

    if not _openssl_available():
        err("openssl no encontrado; no se puede cifrar.")
        warn("Puedes exportar sin cifrar con: sshman export --no-encrypt")
        tmp.unlink(missing_ok=True)
        sys.exit(1)

    # Encrypt with openssl aes-256-cbc + pbkdf2
    passphrase = _ask_passphrase(confirm=True)
    env = dict(os.environ, SSHMAN_PASS=passphrase)
    r = subprocess.run(
        ['openssl', 'enc', '-aes-256-cbc', '-pbkdf2', '-salt',
         '-pass', 'env:SSHMAN_PASS',
         '-in', str(tmp), '-out', str(out)],
        env=env,
    )
    passphrase = None
    tmp.unlink(missing_ok=True)
    if r.returncode != 0:
        err("Fallo al cifrar con openssl."); sys.exit(1)
    try:
        os.chmod(out, 0o600)
    except OSError:
        pass
    ok(f"Vault exportado y cifrado: {out}")
    info("Para restaurar en otra máquina: sshman import " + out.name)

def _looks_encrypted(path):
    if str(path).endswith(".enc"):
        return True
    try:
        with open(path, 'rb') as f:
            return f.read(8) == b"Salted__"
    except OSError:
        return False

def cmd_import(args):
    src = Path(args.file)
    if not src.exists() or not src.is_file():
        err(f"Archivo no encontrado o no es un archivo: {src}"); sys.exit(1)
    ensure_vault()

    import tempfile
    encrypted = _looks_encrypted(src)
    if encrypted:
        if not _openssl_available():
            err("openssl no encontrado; no se puede descifrar."); sys.exit(1)
        passphrase = _ask_passphrase(confirm=False)
        env = dict(os.environ, SSHMAN_PASS=passphrase)
        tmp = Path(tempfile.mktemp(suffix=".tar.gz"))
        r = subprocess.run(
            ['openssl', 'enc', '-d', '-aes-256-cbc', '-pbkdf2',
             '-pass', 'env:SSHMAN_PASS',
             '-in', str(src), '-out', str(tmp)],
            env=env,
        )
        passphrase = None
        if r.returncode != 0:
            tmp.unlink(missing_ok=True)
            err("Fallo al descifrar (¿passphrase incorrecta?)."); sys.exit(1)
        tar_path = tmp
    else:
        warn("El archivo no parece cifrado.")
        tar_path = src

    # Backup current vault config before overwriting
    if VAULT_CONF.exists():
        backup_config()

    with tarfile.open(tar_path, "r:gz") as tar:
        members = []
        vault_root = str(VAULT_DIR.resolve()) + os.sep
        for member in tar.getmembers():
            target = (VAULT_DIR / member.name).resolve()
            managed = member.name.split('/')[0] in ('config', 'keys', 'meta.json')
            if managed and str(target).startswith(vault_root) and \
                    (member.isfile() or member.isdir()):
                members.append(member)
            elif managed:
                err(f"Archivo de vault inseguro: {member.name}")
                sys.exit(1)
        for m in members:
            tar.extract(m, path=VAULT_DIR)

    if encrypted:
        tar_path.unlink(missing_ok=True)

    # Reescribir rutas de llaves al $HOME de esta máquina + chmod 600
    _relocate_keys_paths()
    for k in KEYS_DIR.glob("*"):
        if k.is_file():
            try:
                os.chmod(k, 0o600)
            except OSError:
                pass

    ensure_include()
    ok("Vault importado correctamente.")
    info("Ejecuta 'sshman doctor' para verificar la instalación.")

def _relocate_keys_paths():
    """Rewrite any IdentityFile/ProxyCommand key path so it points to this
    machine's KEYS_DIR (handles a different $HOME after import)."""
    hosts, preamble = parse_config()
    changed = False
    for h in hosts:
        if 'identityfile' in h:
            name = Path(h['identityfile']).name
            candidate = KEYS_DIR / name
            if candidate.exists() and h['identityfile'] != str(candidate):
                h['identityfile'] = str(candidate)
                changed = True
        if 'proxycommand' in h and '/keys/' in h['proxycommand']:
            new_pc = re.sub(r'-i\s+("[^"]+"|\'[^\']+\'|\S+)',
                            lambda m: f"-i {KEYS_DIR / Path(m.group(1).strip('\"\'')).name}",
                            h['proxycommand'])
            if new_pc != h['proxycommand']:
                h['proxycommand'] = new_pc
                changed = True
    if changed:
        write_config(hosts, preamble)

# ----------------------------------------------------------------
# doctor
# ----------------------------------------------------------------
def _all_key_paths(host):
    """Return all key file paths referenced by a host: IdentityFile plus
    any -i <path> in ProxyCommand."""
    paths = []
    if 'identityfile' in host:
        paths.append(os.path.expanduser(str(host['identityfile'])))
    if 'proxycommand' in host:
        for m in re.finditer(r'-i\s+("[^"]+"|\'[^\']+\'|\S+)',
                             host['proxycommand']):
            paths.append(os.path.expanduser(m.group(1).strip('"\'')))
    return paths

def cmd_doctor(args):
    ensure_vault()
    problems = 0

    # 1. Include present?
    inc_ok = False
    if SSH_CONFIG.exists():
        for line in SSH_CONFIG.read_text().splitlines():
            if line.strip().lower().startswith('include') and str(VAULT_CONF) in line:
                inc_ok = True
                break
    if inc_ok:
        ok("Include presente en ~/.ssh/config")
    else:
        problems += 1
        err("Falta el Include en ~/.ssh/config")
        if args.fix:
            ensure_include()

    # 2. Check IdentityFile + ProxyCommand keys
    hosts = get_real_hosts()
    checked_keys = set()
    for h in hosts:
        for kp in _all_key_paths(h):
            if kp in checked_keys:
                continue
            checked_keys.add(kp)
            p = Path(kp)
            if not p.exists():
                problems += 1
                err(f"'{h['Host']}': llave no existe → {kp}")
                continue
            mode = oct(p.stat().st_mode & 0o777)
            if mode != '0o600':
                problems += 1
                err(f"'{h['Host']}': permisos {mode} en {p.name} (deben ser 600)")
                if args.fix:
                    try:
                        os.chmod(p, 0o600)
                        ok(f"  Corregido a 600: {p.name}")
                        problems -= 1
                    except OSError as e:
                        err(f"  No se pudo corregir: {e}")
            else:
                ok(f"'{h['Host']}': llave OK ({p.name})")
        if not h.get('identityfile') and not h.get('proxycommand'):
            warn(f"'{h['Host']}' no tiene IdentityFile")

    print()
    if problems == 0:
        ok("Todo en orden.")
    else:
        warn(f"{problems} problema(s) detectado(s)."
             + ("" if args.fix else " Ejecuta con --fix para corregir."))

