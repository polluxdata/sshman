""")
    sp.set_defaults(func=cmd_migrate)

    sp = sub.add_parser(
        'export', help='Exportar el vault (cifrado)', formatter_class=fmt,
        description='Exporta el vault (config, llaves y meta.json) a un '
                    'archivo .tar.gz cifrado con openssl aes-256-cbc + pbkdf2. '
                    'La passphrase se pide sin eco. El archivo resultante se '
                    'deja con permisos 600.',
        epilog="""Ejemplos:
  sshman export                               cifra con passphrase
  sshman export -o /tmp/mi-vault.enc          ruta destino
  sshman export --no-encrypt                  SIN cifrar (¡inseguro!)
""")
    sp.add_argument('-o', '--output',
                    help='Ruta del archivo destino (por defecto ./sshman-vault-FECHA.tar.gz.enc)')
    sp.add_argument('--no-encrypt', action='store_true',
                    help='Exportar SIN cifrar (las llaves quedan en texto plano)')
    sp.set_defaults(func=cmd_export)

    sp = sub.add_parser(
        'import', help='Importar un vault exportado', formatter_class=fmt,
        description='Restaura un vault exportado por sshman en otra máquina. '
                    'Detecta automáticamente si el archivo está cifrado y pide '
                    'la passphrase. Reescribe las rutas de las llaves para '
                    'apuntar al $HOME actual y repara los permisos a 600.',
        epilog="""Ejemplos:
  sshman import sshman-vault-20240115.tar.gz.enc
  sshman import /tmp/vault.tar.gz
""")
    sp.add_argument('file', help='Archivo de vault exportado (.tar.gz o .enc)')
    sp.set_defaults(func=cmd_import)

    sp = sub.add_parser(
        'doctor', help='Diagnosticar y reparar el vault', formatter_class=fmt,
        description='Verifica la integridad del vault: presencia del Include '
                    'en ~/.ssh/config, existencia y permisos 600 de cada '
                    'llave (IdentityFile y ProxyCommand). Con --fix corrige '
                    'automáticamente el Include y los permisos.',
        epilog="""Ejemplos:
  sshman doctor            solo diagnóstico
  sshman doctor --fix      diagnóstico + corrección automática
""")
    sp.add_argument('--fix', action='store_true',
                    help='Corregir automáticamente problemas detectados')
    sp.set_defaults(func=cmd_doctor)

    return p

def main():
    parser = build_parser()
    argv = sys.argv[1:]

    # Shortcut: `sshman ALIAS` connects directly if ALIAS is not a subcommand.
    known = {'list', 'connect', 'add', 'edit', 'rename', 'remove',
             'show', 'test', 'migrate', 'export', 'import', 'doctor',
             '-h', '--help'}
    if argv and argv[0] not in known:
        argv = ['connect', argv[0]]

    args = parser.parse_args(argv)
    if not getattr(args, 'cmd', None):
        # No command: show host list as a friendly default.
        ensure_vault()
        cmd_list(argparse.Namespace(plain=False))
        return

    # Commands that mutate need the vault to exist first.
    ensure_vault()
    try:
        args.func(args)
    except KeyboardInterrupt:
        print()
        warn("Cancelado.")
        sys.exit(130)

if __name__ == '__main__':
    main()
