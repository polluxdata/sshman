#!/usr/bin/env python3
"""
sshman — Gestor de conexiones SSH portable
PolluxData / Jota

Todo vive en un "vault" autocontenido y portable:

  ~/.sshman/
  ├── config        SSH config gestionado por sshman
  ├── keys/         llaves privadas (chmod 600)
  ├── meta.json     metadata por host (env / color)
  └── backups/      backups con timestamp

sshman garantiza que ~/.ssh/config incluya, al inicio:

  Include ~/.sshman/config

Comandos:
  sshman list [--plain]
  sshman connect [ALIAS]        (o simplemente: sshman ALIAS)
  sshman add [--key RUTA] [--alias A --host H --user U ...]
  sshman edit [ALIAS]
  sshman rename [ALIAS] [NUEVO]
  sshman remove [ALIAS]
  sshman show ALIAS
  sshman test [ALIAS]
  sshman migrate                importa hosts de ~/.ssh/config al vault
  sshman export [-o FILE] [--no-encrypt]
  sshman import FILE
  sshman doctor [--fix]
"""

import argparse
import getpass
import json
import os
import re
import select
import shutil
import subprocess
import sys
import tarfile
import termios
import tty
from datetime import datetime
from pathlib import Path

# ----------------------------------------------------------------
# Rutas del vault
# ----------------------------------------------------------------
HOME        = Path.home()
VAULT_DIR   = HOME / ".sshman"
VAULT_CONF  = VAULT_DIR / "config"
KEYS_DIR    = VAULT_DIR / "keys"
META_FILE   = VAULT_DIR / "meta.json"
BACKUP_DIR  = VAULT_DIR / "backups"
SSH_CONFIG  = HOME / ".ssh" / "config"
INCLUDE_LINE = f"Include {VAULT_CONF}"

def _unquote(val):
    """Strip surrounding quotes from an SSH config value."""
    if len(val) >= 2 and val[0] in ('"', "'") and val[-1] == val[0]:
        return val[1:-1]
    return val

# ----------------------------------------------------------------
# Colores ANSI
# ----------------------------------------------------------------
class C:
    RED    = "\033[31m"
    GREEN  = "\033[32m"
    YELLOW = "\033[33m"
    CYAN   = "\033[36m"
    BOLD   = "\033[1m"
    DIM    = "\033[2m"
    RESET  = "\033[0m"

def ok(msg):   print(f"{C.GREEN}[OK]{C.RESET}  {msg}")
def err(msg):  print(f"{C.RED}[ERR]{C.RESET} {msg}", file=sys.stderr)
def warn(msg): print(f"{C.YELLOW}[WARN]{C.RESET} {msg}")
def info(msg): print(f"{C.CYAN}{msg}{C.RESET}")

# ----------------------------------------------------------------
# Vault init & Include
# ----------------------------------------------------------------
def ensure_vault():
    """Create the vault directory structure and the Include line if missing."""
    VAULT_DIR.mkdir(parents=True, exist_ok=True)
    KEYS_DIR.mkdir(parents=True, exist_ok=True)
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(VAULT_DIR, 0o700)
        os.chmod(KEYS_DIR, 0o700)
    except OSError:
        pass
    if not VAULT_CONF.exists():
        VAULT_CONF.write_text("")
    if not META_FILE.exists():
        META_FILE.write_text(json.dumps(default_meta(), indent=2) + "\n")
    ensure_include()

def ensure_include():
    """Guarantee that ~/.ssh/config includes the vault config, at the top,
    without duplicating the line."""
    SSH_CONFIG.parent.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(SSH_CONFIG.parent, 0o700)
    except OSError:
        pass

    existing = SSH_CONFIG.read_text() if SSH_CONFIG.exists() else ""
    lines = []
    for line in existing.splitlines(keepends=True):
        s = line.strip()
        if s.lower().startswith("include") and str(VAULT_CONF) in s:
            continue
        lines.append(line)
    header = f"{INCLUDE_LINE}\n\n"
    new_content = header + "".join(lines)
    if new_content != existing:
        SSH_CONFIG.write_text(new_content)
        ok(f"Include agregado a {SSH_CONFIG}")

# ----------------------------------------------------------------
# Backup
# ----------------------------------------------------------------
def backup_config():
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    ts  = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
    dst = BACKUP_DIR / f"config.bak.{ts}"
    if VAULT_CONF.exists():
        shutil.copy2(VAULT_CONF, dst)
    return dst

# ----------------------------------------------------------------
# meta.json (env / color)
# ----------------------------------------------------------------
def default_meta():
    return {
        "color_rules": {
            "prod":    "#2E1414",
            "test":    "#2E2414",
            "staging": "#2E2414",
            "dr":      "#2E2414",
            "dev":     "#142414",
            "lab":     "#142414",
            "bastion": "#241A2E",
        },
        "default_color": "#181A20",
        "hosts": {}
    }

def load_meta():
    if not META_FILE.exists():
        return default_meta()
    try:
        data = json.loads(META_FILE.read_text())
    except (json.JSONDecodeError, OSError):
        warn("meta.json ilegible, usando valores por defecto.")
        return default_meta()
    base = default_meta()
    base.update({k: v for k, v in data.items() if k in base})
    base.setdefault("hosts", {})
    return base

def save_meta(meta):
    META_FILE.write_text(json.dumps(meta, indent=2) + "\n")

def color_for_alias(alias):
    """Resolve background colour from meta.json: explicit host color >
    host env rule > default. No fragile substring matching on the alias."""
    meta = load_meta()
    entry = meta["hosts"].get(alias, {})
    if entry.get("color"):
        return entry["color"]
    env = entry.get("env")
    if env and env in meta["color_rules"]:
        return meta["color_rules"][env]
    return meta["default_color"]

# ----------------------------------------------------------------
# Parser del vault config
# ----------------------------------------------------------------
KNOWN_SSH_OPTIONS = frozenset([
    'hostname', 'user', 'port', 'identityfile', 'proxycommand',
    'proxyjump', 'identitiesonly', 'forwardagent', 'loglevel',
    'compression', 'stricthostkeychecking', 'serveraliveinterval',
    'serveralivecountmax', 'pubkeyauthentication', 'passwordauthentication',
    'batchmode', 'hashknownhosts', 'connecttimeout', 'requesttty',
    'controlmaster', 'controlpath', 'controlpersist', 'tcpkeepalive',
    'preferredauthentications', 'addkeystoagent', 'usekeychain',
])

LABEL_MAP = {
    'hostname':              'HostName',
    'user':                  'User',
    'port':                  'Port',
    'identityfile':          'IdentityFile',
    'proxyjump':             'ProxyJump',
    'proxycommand':          'ProxyCommand',
    'identitiesonly':        'IdentitiesOnly',
    'forwardagent':          'ForwardAgent',
    'serveraliveinterval':   'ServerAliveInterval',
    'serveralivecountmax':   'ServerAliveCountMax',
    'loglevel':              'LogLevel',
    'compression':           'Compression',
    'stricthostkeychecking': 'StrictHostKeyChecking',
    'pubkeyauthentication':  'PubkeyAuthentication',
    'passwordauthentication':'PasswordAuthentication',
    'batchmode':             'BatchMode',
    'hashknownhosts':        'HashKnownHosts',
    'connecttimeout':        'ConnectTimeout',
    'requesttty':            'RequestTTY',
    'controlmaster':         'ControlMaster',
    'controlpath':           'ControlPath',
    'controlpersist':        'ControlPersist',
    'tcpkeepalive':          'TCPKeepAlive',
    'preferredauthentications': 'PreferredAuthentications',
    'addkeystoagent':        'AddKeysToAgent',
    'usekeychain':           'UseKeychain',
}

KEY_ORDER = [
    'hostname', 'user', 'port', 'identityfile',
    'proxyjump', 'proxycommand',
    'identitiesonly', 'forwardagent',
    'serveraliveinterval', 'serveralivecountmax',
    'loglevel', 'compression', 'stricthostkeychecking',
    'pubkeyauthentication', 'passwordauthentication',
    'batchmode', 'hashknownhosts', 'connecttimeout',
]

def parse_config():
    """Parse the vault config preserving unknown options in _extra."""
    hosts, current, preamble = [], None, []
    if not VAULT_CONF.exists():
        return [], []
    with open(VAULT_CONF) as f:
        for line in f:
            stripped = line.strip()
            if not stripped or stripped.startswith('#'):
                if current is None:
                    preamble.append(line)
                continue
            m = re.match(r'^Host\s+(.+)$', stripped, re.IGNORECASE)
            if m:
                if current:
                    hosts.append(current)
                current = {'Host': m.group(1).strip(), '_extra': []}
            elif current is not None:
                m2 = re.match(r'^(\S+)\s+(.+)$', stripped)
                if m2:
                    key = m2.group(1).lower()
                    val = _unquote(m2.group(2).strip())
                    if key in KNOWN_SSH_OPTIONS:
                        current[key] = val
                    else:
                        current['_extra'].append(line)
                else:
                    current['_extra'].append(line)
        if current:
            hosts.append(current)
    return hosts, preamble

def write_config(hosts, preamble):
    bak = backup_config()
    with open(VAULT_CONF, 'w') as f:
        for line in preamble:
            f.write(line)
        for h in hosts:
            f.write(f"\nHost {h['Host']}\n")
            written = set()
            for k in KEY_ORDER:
                if k in h and k not in written:
                    f.write(f"    {LABEL_MAP.get(k, k)} {h[k]}\n")
                    written.add(k)
            for line in h.get('_extra', []):
                f.write(line)
    ok(f"Config guardado  (backup: {bak.name})")

def get_host(hosts, alias):
    for h in hosts:
        if h['Host'].lower() == alias.lower():
            return h
    return None

# ----------------------------------------------------------------
# Helpers comunes
# ----------------------------------------------------------------
def get_real_hosts():
    hosts, _ = parse_config()
    return [h for h in hosts if h['Host'] != '*']

def suggest_aliases(hosts, alias):
    """Return up to 3 aliases that resemble the given (typo) alias."""
    import difflib
    names = [h['Host'] for h in hosts]
    return difflib.get_close_matches(alias, names, n=3, cutoff=0.4)

def resolve_alias(hosts, alias_arg, prompt_str):
    if not hosts:
        warn("No hay hosts configurados. Usa: sshman add")
        sys.exit(0)
    if alias_arg:
        return alias_arg
    selected = fzf_select([h['Host'] for h in hosts], prompt_str=prompt_str)
    if not selected:
        sys.exit(0)
    return selected

def require_host(hosts, alias):
    h = get_host(hosts, alias)
    if not h:
        err(f"No encontrado: '{alias}'")
        matches = suggest_aliases(hosts, alias)
        if matches:
            print(f"  ¿Quisiste decir? {', '.join(matches)}")
        else:
            print("  Usa 'sshman list' para ver los hosts disponibles.")
        sys.exit(1)
    return h

def display_host(host):
    print(f"\n{C.BOLD}  {host['Host']}{C.RESET}")
    print(f"  HostName     {host.get('hostname','')}")
    print(f"  User         {host.get('user','')}")
    if 'port' in host:
        print(f"  Port         {host['port']}")
    if 'identityfile' in host:
        print(f"  IdentityFile {host['identityfile']}")
    if 'proxyjump' in host:
        print(f"  ProxyJump    {host['proxyjump']}")
    if 'proxycommand' in host:
        print(f"  ProxyCommand {host['proxycommand']}")
    if 'identitiesonly' in host:
        print(f"  IdentitiesOnly {host['identitiesonly']}")
    meta = load_meta()["hosts"].get(host['Host'], {})
    if meta.get('env'):
        print(f"  Env          {meta['env']}")
    print()

def jump_of(host):
    """Return a display string for the jump server of a host, or ''."""
    if 'proxyjump' in host:
        return host['proxyjump']
    if 'proxycommand' in host:
        for part in host['proxycommand'].split():
            if '@' in part and not part.startswith('-'):
                return part
    return ''

# ----------------------------------------------------------------
# Gestión de llaves
# ----------------------------------------------------------------
def install_key(src_path, alias):
    """Copy a downloaded key into the vault (chmod 600) and return the
    portable path. Warns the user to delete the original."""
    src = Path(os.path.expanduser(src_path))
    if not src.exists():
        err(f"Llave no encontrada: {src}")
        sys.exit(1)
    if not src.is_file():
        err(f"No es un archivo: {src}")
        sys.exit(1)
    KEYS_DIR.mkdir(parents=True, exist_ok=True)
    suffix = src.suffix if src.suffix in ('.pem', '.key') else '.pem'
    dst = KEYS_DIR / f"{alias}{suffix}"
    if dst.exists():
        resp = input(f"  Ya existe {dst.name}. ¿Sobrescribir? [s/N]: ").strip().lower()
        if resp not in ('s', 'si', 'sí'):
            warn("Cancelado.")
            sys.exit(0)
    shutil.copy2(src, dst)
    os.chmod(dst, 0o600)
    ok(f"Llave copiada a {dst}")
    warn(f"Recuerda borrar la copia original: {src}")
    return str(dst)

# ----------------------------------------------------------------
# Terminal background color (OSC 11)
# ----------------------------------------------------------------
_original_bg_color = None

def _query_terminal_bg():
    """Query the terminal's current bg color via OSC 11 (?), reading the
    response from /dev/tty (not stdin) so it never leaks into the user's
    interactive prompt.  Returns '#rrggbb' or None."""
    try:
        tty_fd = os.open('/dev/tty', os.O_RDWR)
    except OSError:
        return None
    try:
        old = termios.tcgetattr(tty_fd)
    except termios.error:
        os.close(tty_fd); return None
    try:
        tty.setcbreak(tty_fd)
        os.write(tty_fd, b"\033]11;?\007")
        response = b""
        deadline = 0.3
        while True:
            r, _, _ = select.select([tty_fd], [], [], deadline)
            if not r:
                break
            chunk = os.read(tty_fd, 256)
            if not chunk:
                break
            response += chunk
            if b"\007" in response or b"\033\\" in response:
                break
        m = re.search(rb'rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+)', response)
        if m:
            return f"#{m.group(1)[:2].decode()}{m.group(2)[:2].decode()}{m.group(3)[:2].decode()}"
        return None
    except Exception:
        return None
    finally:
        try:
            termios.tcsetattr(tty_fd, termios.TCSADRAIN, old)
        except termios.error:
            pass
        os.close(tty_fd)

def get_original_bg_color():
    global _original_bg_color
    if _original_bg_color is None:
        _original_bg_color = _query_terminal_bg()
    return _original_bg_color

def set_terminal_bg(color_hex):
    sys.stdout.write(f"\033]11;{color_hex}\007")
    sys.stdout.flush()

def restore_terminal_bg():
    original = get_original_bg_color()
    _write_osc11_tty(original or "default")

# ----------------------------------------------------------------
# fzf + prompt
# ----------------------------------------------------------------
def fzf_select(items, prompt_str="", preview_cmd=None):
    if not shutil.which('fzf'):
        err("fzf no encontrado. Instala con: brew install fzf")
        sys.exit(1)
    cmd = ['fzf', f'--prompt={prompt_str}', '--height=50%', '--border',
           '--ansi', '--tac']
    if preview_cmd:
        cmd += ['--preview', preview_cmd]
    result = subprocess.run(cmd, input='\n'.join(items), text=True,
                            capture_output=True)
    return result.stdout.strip() or None

def prompt(label, default=None, required=False):
    hint = f" [{default}]" if default else ""
    while True:
        val = input(f"  {label}{hint}: ").strip()
        if not val and default is not None:
            return default
        if not val and required:
            warn("  Campo obligatorio.")
            continue
        return val or None

def confirm(label):
    return input(f"  {label} [s/N]: ").strip().lower() in ('s', 'si', 'sí')

def valid_port(port):
    try:
        p = int(port)
        return 1 <= p <= 65535
    except (ValueError, TypeError):
        return False

def build_jump(jump, jump_key):
    """Build proxyjump/proxycommand dict fragment from a 'user@host:port'
    string. Returns (key, value) or (None, None) if invalid."""
    if '@' not in jump:
        return None, None
    if ':' in jump:
        jhost, jport = jump.rsplit(':', 1)
    else:
        jhost, jport = jump, '22'
    if not valid_port(jport):
        return None, None
    if jump_key:
        jk = os.path.expanduser(jump_key)
        return 'proxycommand', f"ssh -W %h:%p -i {jk} {jhost} -p {jport}"
    return 'proxyjump', jump

# ----------------------------------------------------------------
# connect
# ----------------------------------------------------------------
def _write_osc11_tty(color):
    """Write OSC 11 directly to /dev/tty so the bg color is applied even
    when the foreground process (ssh) has redirected stdout."""
    try:
        with open('/dev/tty', 'w') as tty:
            tty.write(f"\033]11;{color}\007")
            tty.flush()
    except OSError:
        set_terminal_bg(color)

def cmd_connect(args):
    real = get_real_hosts()
    alias = resolve_alias(real, args.alias, "Conectar a> ")
    require_host(real, alias)
    print(f"\n{C.BOLD}Conectando a {alias}...{C.RESET}")
    if sys.stdout.isatty():
        color = color_for_alias(alias)
        get_original_bg_color()
        _write_osc11_tty(color)
        ssh_cmd = ['ssh', '-t', alias]
        try:
            subprocess.run(ssh_cmd)
        finally:
            restore_terminal_bg()
    else:
        subprocess.run(['ssh', alias])

# ----------------------------------------------------------------
# list  (interactive selection connects)
# ----------------------------------------------------------------
def cmd_list(args):
    real = get_real_hosts()
    if not real:
        warn("No hay hosts configurados. Usa: sshman add")
        return

    if args.plain:
        print(f"\n{'Cliente':<14} {'Alias':<42} {'User@Host':<32} {'Jump':<30}")
        print("─" * 118)
        for h in real:
            client = h['Host'].split('-')[0].upper()
            userhost = f"{h.get('user','?')}@{h.get('hostname','?')}"
            print(f"{client:<14} {h['Host']:<42} {userhost:<32} {jump_of(h)}")
        print()
        return

    lines = []
    for h in real:
        client = h['Host'].split('-')[0].upper()
        col2 = f"{h.get('user','?')}@{h.get('hostname','?')}"
        jump = jump_of(h)
        col3 = f"→ {jump}" if jump else ''
        lines.append(f"{C.CYAN}{client:<12}{C.RESET} {h['Host']:<45} "
                     f"{col2:<35} {C.DIM}{col3}{C.RESET}")
    preview = ("echo {} | sed 's/\\x1b\\[[0-9;]*m//g' | awk '{print $2}' | "
               "xargs -I% sh -c 'grep -A10 \"^Host %$\" ~/.sshman/config "
               "2>/dev/null || echo \"(sin detalles)\"'")
    selected = fzf_select(lines, prompt_str="Host (Enter=conectar)> ",
                          preview_cmd=preview)
    if not selected:
        return
    clean = re.sub(r'\033\[[0-9;]*m', '', selected).strip()
    parts = clean.split()
    if len(parts) < 2:
        err("No se pudo extraer el alias de la selección.")
        return
    alias = parts[1]
    require_host(real, alias)
    # Selecting a host connects to it directly.
    args.alias = alias
    cmd_connect(args)

# ----------------------------------------------------------------
# add
# ----------------------------------------------------------------
def cmd_add(args):
    ensure_vault()
    hosts, preamble = parse_config()

    non_interactive = bool(args.alias and args.host and args.user)
    if non_interactive:
        alias, hostname, user = args.alias, args.host, args.user
        port, jump, jump_key = args.port, args.jump, args.jump_key
        key = args.key
        env = args.env
    else:
        info("\n── Agregar nueva conexión ──────────────────────────\n")
        alias    = prompt("Alias  (ej: ucuenca-prod-nuevo)", required=True)
        hostname = prompt("Hostname / IP", required=True)
        user     = prompt("Usuario", required=True)
        port     = prompt("Puerto", default="22")
        key      = args.key or prompt("Ruta llave .pem descargada  (vacío si no aplica)")
        jump = jump_key = None
        if confirm("¿Tiene bastión / jump server?"):
            jump = prompt("  Jump  usuario@host:puerto", required=True)
            jk = prompt("  Ruta llave jump .pem  (vacío si misma llave)")
            jump_key = jk
        env = prompt("Entorno (prod/test/dev/bastion/otro)", default="otro")

    if get_host(hosts, alias):
        err(f"El alias '{alias}' ya existe. Usa: sshman edit {alias}")
        sys.exit(1)
    if ' ' in alias:
        err("El alias no puede contener espacios.")
        sys.exit(1)
    if port and not valid_port(port):
        err(f"Puerto inválido: {port}")
        sys.exit(1)

    new = {'Host': alias, '_extra': [], 'hostname': hostname, 'user': user}
    if port and port != '22':
        new['port'] = port

    # Install the key into the vault (copy + chmod 600)
    if key:
        new['identityfile'] = install_key(key, alias)
        new['identitiesonly'] = 'yes'

    if jump:
        jk, jv = build_jump(jump, jump_key)
        if not jk:
            err(f"Jump inválido: '{jump}'. Formato: usuario@host:puerto")
            sys.exit(1)
        new[jk] = jv

    # Insert near hosts of the same client prefix
    client = alias.split('-')[0].lower()
    insert_at = len(hosts)
    for i, h in enumerate(hosts):
        if h['Host'] != '*' and h['Host'].lower().startswith(client):
            insert_at = i + 1

    hosts.insert(insert_at, new)
    write_config(hosts, preamble)

    # Record env metadata
    if env and env != 'otro':
        meta = load_meta()
        meta['hosts'][alias] = {'env': env}
        save_meta(meta)

    ok(f"'{alias}'  →  {user}@{hostname}" + (f"  (jump: {jump})" if jump else ""))

    # Validate and optionally test-connect
    print()
    if _ssh_g_ok(alias) and sys.stdout.isatty() and not non_interactive:
        if confirm("¿Conectar ahora para probar?"):
            cmd_connect(argparse.Namespace(alias=alias))

def _ssh_g_ok(alias):
    try:
        r = subprocess.run(['ssh', '-G', alias], capture_output=True,
                           text=True, timeout=10)
        if r.returncode == 0:
            ok("Validación ssh -G correcta")
            return True
        err("ssh -G falló:")
        if r.stderr:
            print(f"  {r.stderr.strip()}")
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        err(f"ssh -G: {e}")
    return False

# ----------------------------------------------------------------
# show / test
# ----------------------------------------------------------------
def cmd_show(args):
    real = get_real_hosts()
    alias = args.alias or resolve_alias(real, None, "Ver> ")
    display_host(require_host(real, alias))

def cmd_test(args):
    real = get_real_hosts()
    alias = resolve_alias(real, args.alias, "Testear> ")
    require_host(real, alias)
    print(f"\n{C.BOLD}Probando configuración para {alias}...{C.RESET}")
    try:
        result = subprocess.run(['ssh', '-G', alias],
                                capture_output=True, text=True, timeout=10)
    except subprocess.TimeoutExpired:
        err("ssh -G timeout (10s)"); sys.exit(1)
    except FileNotFoundError:
        err("ssh no encontrado en PATH"); sys.exit(1)
    if result.returncode != 0:
        err("ssh -G falló:")
        if result.stderr:
            print(f"  {result.stderr.strip()}")
        sys.exit(1)
    ok("ssh -G pasó correctamente")
    print()
    show_keys = ('hostname', 'user', 'port', 'identityfile',
                 'proxycommand', 'proxyjump', 'stricthostkeychecking')
    for line in result.stdout.strip().split('\n'):
        parts = line.split(None, 1)
        if len(parts) == 2 and parts[0] in show_keys:
            print(f"  {parts[0]:<25} {parts[1]}")
    print()

# ----------------------------------------------------------------
# remove
# ----------------------------------------------------------------
def cmd_remove(args):
    hosts, preamble = parse_config()
    real = [h for h in hosts if h['Host'] != '*']
    alias = resolve_alias(real, args.alias, "Eliminar> ")
    host = require_host(real, alias)

    print(f"\n  {C.BOLD}{alias}{C.RESET}  →  "
          f"{host.get('user','?')}@{host.get('hostname','?')}")
    if not confirm("¿Confirmar eliminación?"):
        warn("Cancelado."); return

    # Offer to delete the associated key if it lives in the vault
    keypath = host.get('identityfile', '')
    hosts = [h for h in hosts if h['Host'] != alias]
    write_config(hosts, preamble)

    meta = load_meta()
    if alias in meta['hosts']:
        del meta['hosts'][alias]
        save_meta(meta)

    if keypath and str(KEYS_DIR) in keypath and Path(keypath).exists():
        if confirm(f"¿Borrar también la llave {Path(keypath).name}?"):
            try:
                Path(keypath).unlink()
                ok("Llave eliminada.")
            except OSError as e:
                err(f"No se pudo borrar la llave: {e}")

    ok(f"'{alias}' eliminado.")

